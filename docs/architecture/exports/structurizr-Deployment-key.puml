@startuml

set separator none
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container,Agent
  .Element-RWxlbWVudCxDb250YWluZXIsQWdlbnQ= {
    BackgroundColor: #c0392b;
    LineColor: #86271e;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Container,ControlPoint
  .Element-RWxlbWVudCxDb250YWluZXIsQ29udHJvbFBvaW50 {
    BackgroundColor: #b8860b;
    LineColor: #805d07;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Container,Data
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YQ== {
    BackgroundColor: #2e7d32;
    LineColor: #205723;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Container,Model
  .Element-RWxlbWVudCxDb250YWluZXIsTW9kZWw= {
    BackgroundColor: #6b4fa0;
    LineColor: #4a3770;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Container,Observability
  .Element-RWxlbWVudCxDb250YWluZXIsT2JzZXJ2YWJpbGl0eQ== {
    BackgroundColor: #00695c;
    LineColor: #004940;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Container,UI
  .Element-RWxlbWVudCxDb250YWluZXIsVUk= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Broken
  .Relationship-UmVsYXRpb25zaGlwLEJyb2tlbg== {
    LineThickness: 2;
    LineStyle: 2-2;
    LineColor: #b00020;
    FontColor: #b00020;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Element
  .DeploymentNode-RWxlbWVudA== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // transparent element for relationships in legend
  .Element-Transparent {
    BackgroundColor: transparent;
    LineColor: transparent;
    FontColor: transparent;
  }
</style>

rectangle "==Element" <<DeploymentNode-RWxlbWVudA==>>

rectangle "==Container, Agent" <<Element-RWxlbWVudCxDb250YWluZXIsQWdlbnQ=>>

hexagon "==Container, ControlPoint" <<Element-RWxlbWVudCxDb250YWluZXIsQ29udHJvbFBvaW50>>

database "==Container, Data" <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YQ==>>

rectangle "==Container, Model" <<Element-RWxlbWVudCxDb250YWluZXIsTW9kZWw=>>

rectangle "==Container, Observability" <<Element-RWxlbWVudCxDb250YWluZXIsT2JzZXJ2YWJpbGl0eQ==>>

rectangle "==Container, UI" <<Element-RWxlbWVudCxDb250YWluZXIsVUk=>>

rectangle "." <<.Element-Transparent>> as 1
1 --> 1 <<Relationship-UmVsYXRpb25zaGlw>> : "Relationship"

rectangle "." <<.Element-Transparent>> as 2
2 --> 2 <<Relationship-UmVsYXRpb25zaGlwLEJyb2tlbg==>> : "Broken"

@enduml