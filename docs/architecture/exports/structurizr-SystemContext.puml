@startuml
title <size:24>System Context View: Agentic Platform (local)</size>\n<size:24>Who uses the platform, and the one external system it can reach.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,External,Optional
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsT3B0aW9uYWw= {
    BackgroundColor: #999999;
    LineColor: #6b6b6b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Optional
  .Relationship-UmVsYXRpb25zaGlwLE9wdGlvbmFs {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
</style>

person "==Shopper\n<size:16>[Person]</size>\n\nAsks about their order in natural language." <<Element-RWxlbWVudCxQZXJzb24=>> as Shopper
person "==Platform Operator\n<size:16>[Person]</size>\n\nRuns the cluster and owns the control points." <<Element-RWxlbWVudCxQZXJzb24=>> as PlatformOperator
rectangle "==Anthropic API\n<size:16>[Software System]</size>\n\nFrontier model, used only where a local model is not good enough (labs 6-7)." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsT3B0aW9uYWw=>> as AnthropicAPI
rectangle "==Agentic Platform (local)\n<size:16>[Software System]</size>\n\nCustomer-service agent and the infrastructure that governs it." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as AgenticPlatformlocal

Shopper --> AgenticPlatformlocal <<Relationship-UmVsYXRpb25zaGlw>> : "Asks about an order"
PlatformOperator --> AgenticPlatformlocal <<Relationship-UmVsYXRpb25zaGlw>> : "Changes the model alias table (no agent redeploy)"
AgenticPlatformlocal --> AnthropicAPI <<Relationship-UmVsYXRpb25zaGlwLE9wdGlvbmFs>> : "Same hop, different backend — a config change, not a code change\n<size:16>[HTTPS, Anthropic wire format]</size>"

@enduml