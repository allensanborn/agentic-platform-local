@startuml
title <size:24>Deployment View: Agentic Platform (local) - Laptop</size>\n<size:24>Where each container actually runs — and the two host-boundary gotchas that cost real debugging time.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container,Agent
  .Element-RWxlbWVudCxDb250YWluZXIsQWdlbnQ= {
    BackgroundColor: #c0392b;
    LineColor: #86271e;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,ControlPoint
  .Element-RWxlbWVudCxDb250YWluZXIsQ29udHJvbFBvaW50 {
