rectangle "Developer Laptop (macOS, Apple Silicon)\n<size:16>[Deployment Node]</size>" <<DeploymentNode-RWxlbWVudA==>> as Laptop.DeveloperLaptopmacOSAppleSilicon {
  rectangle "Host OS\n<size:16>[Deployment Node]</size>" <<DeploymentNode-RWxlbWVudA==>> as Laptop.DeveloperLaptopmacOSAppleSilicon.HostOS {
    rectangle "Ollama\n<size:16>[Deployment Node]</size>" <<DeploymentNode-RWxlbWVudA==>> as Laptop.DeveloperLaptopmacOSAppleSilicon.HostOS.Ollama {
      rectangle "==Local Model Runtime\n<size:16>[Container: Ollama (workshop: Amazon Bedrock)]</size>\n\nServes qwen3:8b and llama3.2:1b over an OpenAI-compatible API. Runs on the HOST, not in the cluster, because that is where the GPU is." <<Element-RWxlbWVudCxDb250YWluZXIsTW9kZWw=>> as Laptop.DeveloperLaptopmacOSAppleSilicon.HostOS.Ollama.LocalModelRuntime_1
    }

  }

  rectangle "Docker Desktop VM\n<size:16>[Deployment Node]</size>" <<DeploymentNode-RWxlbWVudA==>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM {
    rectangle "k3d cluster 'agentic'\n<size:16>[Deployment Node]</size>" <<DeploymentNode-RWxlbWVudA==>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic {
      rectangle "namespace: envoy-gateway-system\n<size:16>[Deployment Node]</size>" <<DeploymentNode-RWxlbWVudA==>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic.namespaceenvoygatewaysystem {
        rectangle "Envoy data plane\n<size:16>[Deployment Node]</size>" <<DeploymentNode-RWxlbWVudA==>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic.namespaceenvoygatewaysystem.Envoydataplane {
          hexagon "==AI Gateway\n<size:16>[Container: Envoy AI Gateway (workshop: same, fronting Bedrock)]</size>\n\nLAB 0 control point. Owns WHICH model answers: agents ask for an alias, the gateway rewrites it to a real model. Also the only thing that would hold a model credential." <<Element-RWxlbWVudCxDb250YWluZXIsQ29udHJvbFBvaW50>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic.namespaceenvoygatewaysystem.Envoydataplane.AIGateway_1
        }

      }

      rectangle "namespace: telemetry\n<size:16>[Deployment Node]</size>" <<DeploymentNode-RWxlbWVudA==>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic.namespacetelemetry {
        hexagon "==OTel Collector\n<size:16>[Container: OpenTelemetry Collector (workshop: same)]</size>\n\nLAB 2 control point. Every workload speaks plain OTLP here and holds NO credential for the tracing backend — one key to rotate. Also where telemetry is SHAPED: a filter rule drops the per-SSE-chunk spans that took one trace from 543 spans to 9." <<Element-RWxlbWVudCxDb250YWluZXIsQ29udHJvbFBvaW50>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic.namespacetelemetry.OTelCollector_1
        rectangle "==Trace Backend\n<size:16>[Container: Jaeger (workshop: Langfuse — six containers, would not fit here; see ADR 0004)]</size>\n\nRenders the agent trace tree: invoke_agent -> event loop -> chat -> tool, with GenAI semantic-convention attributes." <<Element-RWxlbWVudCxDb250YWluZXIsT2JzZXJ2YWJpbGl0eQ==>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic.namespacetelemetry.TraceBackend_1
      }

      rectangle "namespace: default\n<size:16>[Deployment Node]</size>" <<DeploymentNode-RWxlbWVudA==>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic.namespacedefault {
        rectangle "Deployment: customer-agent\n<size:16>[Deployment Node]</size>" <<DeploymentNode-RWxlbWVudA==>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic.namespacedefault.Deploymentcustomeragent {
          rectangle "==Customer Agent\n<size:16>[Container: Python, Strands Agents SDK, FastAPI]</size>\n\nAgent loop: picks tools, calls the model, streams SSE. agent.py/server.py run VERBATIM from the workshop." <<Element-RWxlbWVudCxDb250YWluZXIsQWdlbnQ=>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic.namespacedefault.Deploymentcustomeragent.CustomerAgent_1
          database "==Orders Store\n<size:16>[Container: SQLite (workshop: Amazon DynamoDB)]</size>\n\n500 seeded orders. Read via a scoped, parameterized query — the agent never writes SQL." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YQ==>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic.namespacedefault.Deploymentcustomeragent.OrdersStore_1
        }

        rectangle "Deployment: chat-ui\n<size:16>[Deployment Node]</size>" <<DeploymentNode-RWxlbWVudA==>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic.namespacedefault.Deploymentchatui {
          rectangle "==Chat UI\n<size:16>[Container: Chainlit (workshop: same)]</size>\n\nStreams the agent's answer and renders tool calls as steps." <<Element-RWxlbWVudCxDb250YWluZXIsVUk=>> as Laptop.DeveloperLaptopmacOSAppleSilicon.DockerDesktopVM.k3dclusteragentic.namespacedefault.Deploymentchatui.ChatUI_1
        }

      }

    }

  }

}

