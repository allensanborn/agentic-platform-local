  // Element,Container,Model
  .Element-RWxlbWVudCxDb250YWluZXIsTW9kZWw= {
    BackgroundColor: #6b4fa0;
    LineColor: #4a3770;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Observability
  .Element-RWxlbWVudCxDb250YWluZXIsT2JzZXJ2YWJpbGl0eQ== {
    BackgroundColor: #00695c;
    LineColor: #004940;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,UI
  .Element-RWxlbWVudCxDb250YWluZXIsVUk= {
